# ---------------------------------------------------------------------------
# LLM providers (all free tiers)
# ---------------------------------------------------------------------------
# Set at least one. Providers are tried in the order listed below, so adding
# more keys only widens the fallback chain -- it never changes behaviour when
# the first provider is healthy. Free tiers rate-limit often, so two or more
# keys is strongly recommended for a demo that must not stall mid-run.
#
#   Groq      https://console.groq.com/keys        fast, generous free tier
#   Gemini    https://aistudio.google.com/apikey   largest free daily quota
#   Cerebras  https://cloud.cerebras.ai            very low latency
#   OpenRouter https://openrouter.ai/keys          broad catalogue, ~50 req/day

GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Optional: override the try order (comma-separated provider names).
# LLM_PROVIDER_ORDER=groq,gemini,cerebras,openrouter

# Optional: override the model list per provider (comma-separated, tried in order).
# GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b
# GEMINI_MODELS=gemini-2.0-flash
# CEREBRAS_MODELS=llama-3.3-70b
# OPENROUTER_MODELS=openai/gpt-oss-120b:free

# Optional tuning.
# LLM_TIMEOUT_SECONDS=120
# TEST_TIMEOUT_SECONDS=20

# OpenRouter free-tier attribution (only used when OpenRouter serves a call).
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_NAME=IronTest

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------
USE_MONGODB=false
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=irontest
MONGODB_COLLECTION=executions

# ---------------------------------------------------------------------------
# Issue tracker ingestion (optional)
# ---------------------------------------------------------------------------
JIRA_EMAIL=
JIRA_API_TOKEN=
AZURE_DEVOPS_PAT=

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
VITE_API_BASE=http://localhost:8000

# ---------------------------------------------------------------------------
# Test execution sandbox
# ---------------------------------------------------------------------------
# Generated tests import the target repository's real code, so they run in a
# sandbox rather than on the API host.
#
#   auto            prefer GitHub Actions when configured, else Docker
#   docker          run in a local container (good for local development)
#   github_actions  run on GitHub's runners (required for a deployed install)
TEST_RUNNER=auto

# GitHub Actions backend. Create a private, otherwise-empty repository, copy
# deploy/irontest-runner.yml into its .github/workflows/, and issue a token
# with actions:write on it. Tests then run on GitHub's free runners, and the
# repositories under test are only ever cloned, never written to.
ACTIONS_RUNNER_REPO=
ACTIONS_DISPATCH_TOKEN=
# ACTIONS_RUNNER_REF=main
# ACTIONS_WORKFLOW_FILE=irontest-runner.yml

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development
# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# SQLite locally; set to the Postgres URL in production.
DATABASE_URL=sqlite:///./data/irontest.db

# ---------------------------------------------------------------------------
# GitHub OAuth (https://github.com/settings/developers -> New OAuth App)
# ---------------------------------------------------------------------------
# Authorization callback URL must match GITHUB_CALLBACK_URL exactly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/auth/github/callback

FRONTEND_URL=http://localhost:5173
# Comma-separated extra origins, e.g. Vercel preview deployments.
# EXTRA_CORS_ORIGINS=https://your-app-git-branch.vercel.app

# How long a sign-in lasts, in hours. Default 336 (14 days).
# SESSION_TTL_HOURS=336

# ---------------------------------------------------------------------------
# Email notifications (optional)
# ---------------------------------------------------------------------------
# Sends a run summary when the user ticks "email me the results". Leave
# SMTP_HOST blank to disable; runs then report the send as skipped rather
# than failing.
#
# Gmail needs an App Password, not your account password:
#   https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Defaults to SMTP_USERNAME when blank.
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_SUBJECT_PREFIX=IronTest
