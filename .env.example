# Core LLM settings
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL_ID=gemini-2.5-flash
GEMINI_MODEL_CANDIDATES=gemini-2.5-flash-lite,gemini-1.5-flash-8b

# Persistence (MongoDB)
USE_MONGODB=true
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=irontest
MONGODB_COLLECTION=executions

# Jira ingestion (optional if passed from UI)
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your_jira_api_token

# Frontend API endpoint (optional for local dev)
VITE_API_BASE=http://localhost:8000
