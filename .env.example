# ---------------------------------------------------------------------------
# LLM providers (all free tiers)
# ---------------------------------------------------------------------------
# Set at least one. Providers are tried in the order listed below, so adding
# more keys only widens the fallback chain -- it never changes behaviour when
# the first provider is healthy. Free tiers rate-limit often, so two or more
# keys is strongly recommended for a demo that must not stall mid-run.
#
#   Groq      https://console.groq.com/keys        fast, generous free tier
#   Gemini    https://aistudio.google.com/apikey   largest free daily quota
#   Cerebras  https://cloud.cerebras.ai            very low latency
#   OpenRouter https://openrouter.ai/keys          broad catalogue, ~50 req/day

GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Optional: override the try order (comma-separated provider names).
# LLM_PROVIDER_ORDER=groq,gemini,cerebras,openrouter

# Optional: override the model list per provider (comma-separated, tried in order).
# GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b
# GEMINI_MODELS=gemini-2.0-flash
# CEREBRAS_MODELS=llama-3.3-70b
# OPENROUTER_MODELS=openai/gpt-oss-120b:free

# Optional tuning.
# LLM_TIMEOUT_SECONDS=120
# TEST_TIMEOUT_SECONDS=20

# OpenRouter free-tier attribution (only used when OpenRouter serves a call).
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_NAME=IronTest

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------
USE_MONGODB=false
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=irontest
MONGODB_COLLECTION=executions

# ---------------------------------------------------------------------------
# Issue tracker ingestion (optional)
# ---------------------------------------------------------------------------
JIRA_EMAIL=
JIRA_API_TOKEN=
AZURE_DEVOPS_PAT=

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
VITE_API_BASE=http://localhost:8000
