# Core LLM settings
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL_ID=openai/gpt-oss-120b:free
OPENROUTER_MODEL_CANDIDATES=openai/gpt-oss-20b:free
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_NAME=IronTest QA Agent

# Persistence (MongoDB)
USE_MONGODB=true
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=irontest
MONGODB_COLLECTION=executions

# Jira ingestion (optional if passed from UI)
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your_jira_api_token

# Frontend API endpoint (optional for local dev)
VITE_API_BASE=http://localhost:8000
